class SOLBot:
    def __init__(self):
        self.name = "SOL Bot"
        print(f"{self.name} initialized and ready to assist!")

    def get_user_input(self):
        return input("How can I help you today? ")

    def process_input(self, user_input):
        # Basic solution-oriented response logic
        if "problem" in user_input.lower() or "issue" in user_input.lower():
            return "I understand you're facing a challenge. Let's break it down and find a solution."
        elif "help" in user_input.lower():
            return "I'm here to help! Could you provide more details?"
        else:
            return "That's interesting! Let's think of a constructive approach to handle this."

    def run(self):
        print("Hello! I am SOL Bot, your solution-oriented assistant.")
        while True:
            user_input = self.get_user_input()
            if user_input.lower() in ["exit", "quit", "bye"]:
                print("Thank you for chatting! Have a productive day ahead.")
                break
            response = self.process_input(user_input)
            print(response)


if __name__ == "__main__":
    bot = SOLBot()
    bot.run()

How it works:
The bot greets the user and waits for input.
It detects if the user is mentioning a problem, asking for help, or just talking.
It responds with a solution-oriented reply.
The chat loop continues until the user types exit, quit, or bye.

